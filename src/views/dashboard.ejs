<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-card">
            <h2>Dashboard</h2>
            <p>Name: <%= name %>
            </p>
            <p>Email: <%= email %>
            </p>
