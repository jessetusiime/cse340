<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-card">
            <h2>Dashboard</h2>
            <p>Name: <%= name %>
            </p>
            <p>Email: <%= email %>
            </p>
        </div>

        <% if (user && user.role_name==='admin' ) { %>

            <p>
                <a href="/users">
                    View All Users
                </a>
            </p>

            <% } %>

            <h3>My Volunteer Projects</h3>
            
            <% if (volunteerProjects.length> 0) { %>
            
                <ul>
            
                    <% volunteerProjects.forEach(project=> { %>
            
                        <li>
                            <%= project.title %>
            
                                <a href="/remove-volunteer/<%= project.project_id %>">
                                    Remove
                                </a>
                        </li>
            
                        <% }) %>
            
                </ul>
            
                <% } else { %>
            
                    <p>
                        You have not signed up for any projects yet.
                    </p>
            
                    <% } %>

    </main>

    <%- include('partials/footer') %>