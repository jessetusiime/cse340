<%- include('partials/header') %>

    <main>

        <h1>
            <%= organization.name %>
        </h1>

        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

        <p>
            <%= organization.description %>
        </p>

        <p>
            Contact Email:
            <%= organization.contact_email %>
        </p>

        <h2>Service Projects</h2>
        <% if (projects.length> 0) { %>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.name %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p>No projects are currently associated with this organization.</p>
                <% } %>

    </main>

    <%- include('partials/footer') %>