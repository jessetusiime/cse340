<%- include('partials/header') %>

    <main>

        <h1>
            <%= organizationDetails.name %>
        </h1>

        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

        <p>
            <%= organizationDetails.description %>
        </p>

        <p>
            Contact Email:
            <%= organizationDetails.contact_email %>
        </p>

        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-organization/<%= organizationDetails.organization_id %>">
                    Edit Organization
                </a>
                <% } %>
        </p>

        <h2>Service Projects</h2>

        <% if (projects.length> 0) { %>
            <ul>
                <% projects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p>No projects are currently associated with this organization.</p>
                <% } %>

    </main>

    <%- include('partials/footer') %>